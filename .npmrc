# Peer dependency conflicts between eslint-config-next / typescript-eslint
# and this project's newer eslint@10 / typescript@7 are warnings under npm 10
# (Node 22) but hard errors under npm 11 (Node 24). Allow the install to
# proceed with the same relaxed resolution used before the base-image upgrade.
legacy-peer-deps=true
# Supply-chain guard (npm >= 11.10): never resolve a version published in the
# last 7 days, so a freshly published — potentially compromised — release can
# never be picked up by `npm install`/dependency bumps. Mirrors the
# `cooldown: default-days: 7` already configured in .github/dependabot.yml.
# `npm ci` still installs the exact audited versions from package-lock.json.
# See Semgrep rule package_managers.npm.npm-missing-minimum-release-age.
min-release-age=7
