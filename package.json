{
  "name": "ai-food-diary",
  "version": "0.68.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsc --noEmit && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "encryption:rotate": "tsx scripts/rotate-encryption.ts",
    "encryption:backfill:b1": "tsx scripts/backfill-encryption-b1.ts",
    "encryption:backfill:b2": "tsx scripts/backfill-encryption-b2.ts",
    "encryption:migrate:status": "tsx scripts/encryption-migration.ts status",
    "encryption:migrate:verify": "tsx scripts/encryption-migration.ts verify",
    "encryption:migrate:apply": "tsx scripts/encryption-migration.ts apply",
    "encryption:stage-d:status": "tsx scripts/encryption-stage-d.ts status",
    "encryption:stage-d:apply": "tsx scripts/encryption-stage-d.ts apply",
    "encryption:stage-d:rollback": "tsx scripts/encryption-stage-d.ts rollback",
    "encryption:disk:check": "tsx scripts/disk-encryption-check.ts",
    "encryption:images": "tsx --conditions=react-server scripts/backfill-image-encryption.ts",
    "worker": "tsx --conditions=react-server src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.2",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "next": "^16.3.1",
    "openai": "^7.5.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "@hono/node-server": "^1.19.13",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "eslint-config-next": {
      "minimatch": "^10.0.3"
    },
    "valibot": "^1.4.2",
    "find-my-way": "^9.7.0",
    "sharp": "^0.35.0"
  }
}
