{
  "name": "ai-food-diary",
  "version": "0.77.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsc --noEmit && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "encryption:rotate": "tsx scripts/rotate-encryption.ts",
    "encryption:backfill:b1": "tsx scripts/backfill-encryption-b1.ts",
    "encryption:backfill:b2": "tsx scripts/backfill-encryption-b2.ts",
    "encryption:migrate:status": "tsx scripts/encryption-migration.ts status",
    "encryption:migrate:verify": "tsx scripts/encryption-migration.ts verify",
    "encryption:migrate:apply": "tsx scripts/encryption-migration.ts apply",
    "encryption:stage-d:status": "tsx scripts/encryption-stage-d.ts status",
    "encryption:stage-d:apply": "tsx scripts/encryption-stage-d.ts apply",
    "encryption:stage-d:rollback": "tsx scripts/encryption-stage-d.ts rollback",
    "encryption:disk:check": "tsx scripts/disk-encryption-check.ts",
    "encryption:images": "tsx --conditions=react-server scripts/backfill-image-encryption.ts",
    "admin:data:verify:export": "tsx scripts/admin-data-export-import-check.ts export",
    "admin:data:verify:roundtrip": "tsx scripts/admin-data-export-import-check.ts roundtrip",
    "admin:data:verify:wipe": "tsx scripts/admin-data-export-import-check.ts wipe",
    "test:mcp": "node --conditions=react-server --import tsx --test tests/mcp/*.test.ts",
    "worker": "tsx --conditions=react-server src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.75.0",
    "@sentry/profiling-node": "^10.75.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.7",
    "dotenv": "^18.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "next": "^16.3.5",
    "openai": "^7.18.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "@hono/node-server": "^1.19.13",
    "esbuild": "^0.28.2",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^4.2.0",
    "valibot": "^1.5.0",
    "find-my-way": "^9.9.0",
    "sharp": "^0.35.4",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
